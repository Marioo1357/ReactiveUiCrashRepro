<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ReactiveUiCrashRepro.Controls.MauiGlassActionButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        x:Name="GlassBorder"
        Padding="16,12"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="22" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow
                Brush="Black"
                Offset="0,2"
                Opacity="0.15"
                Radius="8" />
        </Border.Shadow>

        <HorizontalStackLayout
            x:Name="ContentStack"
            HorizontalOptions="Center"
            Spacing="8"
            VerticalOptions="Center" />

    </Border>

</ContentView>
