<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ReactiveUiCrashRepro.Controls.MauiGlassNavigationBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        x:Name="GlassBorder"
        Padding="12,8"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="22" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow
                Brush="Black"
                Offset="0,2"
                Opacity="0.15"
                Radius="8" />
        </Border.Shadow>

        <Grid x:Name="ContentGrid" ColumnDefinitions="Auto,*,Auto">

            <!--  Back button area (built in code-behind)  -->
            <HorizontalStackLayout
                x:Name="BackButtonContainer"
                Grid.Column="0"
                Spacing="4"
                VerticalOptions="Center" />

            <!--  Title  -->
            <Label
                x:Name="TitleLabel"
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="17"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center" />

            <!--  Action buttons area (built in code-behind)  -->
            <HorizontalStackLayout
                x:Name="ActionButtonsContainer"
                Grid.Column="2"
                Spacing="12"
                VerticalOptions="Center" />

        </Grid>

    </Border>

</ContentView>
