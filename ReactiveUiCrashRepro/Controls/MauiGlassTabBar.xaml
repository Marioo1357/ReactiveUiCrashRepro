<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ReactiveUiCrashRepro.Controls.MauiGlassTabBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        x:Name="GlassBorder"
        Margin="12,0,12,6"
        Padding="8,6"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="26" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow
                Brush="Black"
                Offset="0,-2"
                Opacity="0.12"
                Radius="14" />
        </Border.Shadow>

        <Grid x:Name="TabGrid" ColumnSpacing="4" />

    </Border>

</ContentView>
